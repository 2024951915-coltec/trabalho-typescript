<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>Minhas notas!</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </head>

    <body>
        <form class="form-control" method="POST" action="send">
            <input class="form-control" type="text" name="title" id="title">
            <textarea class="form-control"  name="message" id="message" placeholder="Escreva sua nota!"></textarea>

            <input class="btn btn-primary" type="submit" value="Enviar">
        </form>
        
        <% NOTES.forEach((note, idx, arr) => { %>
            <% if(idx % 3 == 0) { %>
            <div class="row">
            <% } %>

            <div class="col-md-3">
                <div class="card card-body">
                    <h1 class="card-title"><%= note.title %></h1>
                    <p class="card-text"><%= note.message %></p>
                </div>
            </div>

            <% if(idx % 3 == 2) { %>
            </div>
            <% } %>
        <% }); %>
    </body>
</html>